# Storage: leave MONGO_URL empty to use the in-process cache + rate limiter.
MONGO_URL=
DB_NAME=page_pulse

# Outbound requests
AUDIT_TIMEOUT_SECONDS=10
AUDIT_MAX_CONCURRENCY=50
AUDIT_MAX_DOWNLOAD_BYTES=2000000
AUDIT_MAX_REDIRECTS=5

# Caching
CACHE_TTL_SECONDS=300

# Rate limiting (per client, fixed window)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=3600

# Batch endpoint
MAX_BATCH_SIZE=10

# Set to true only for local testing against localhost targets.
ALLOW_PRIVATE_TARGETS=false

CORS_ORIGINS=*
LOG_LEVEL=INFO
